---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { actions, isInputError } from "astro:actions";
import Alert from "~/components/forms/Alert.astro";
import Field from "~/components/forms/Field.astro";
import SubmitButton from "~/components/forms/SubmitButton.astro";

export const prerender = false;

const result = Astro.getActionResult(actions.auth.requestLink);
const sent = Boolean(result && !result.error);

// Query-string errors come from the magic-link handler and the members
// guard (src/pages/api/auth/verify.ts, src/middleware.ts).
const params = Astro.url.searchParams;
const queryError = params.get("error");
// The query string is attacker-controllable, so only well-formed variable
// names are echoed back, and always as text.
const missing = (params.get("missing") ?? "")
  .split(",")
  .filter((name) => /^[A-Z][A-Z0-9_]{2,63}$/.test(name))
  .slice(0, 12);

// An invalid email is an input error — show it inline on the field. Every
// other problem (config, expired link, gated redirect) is a page-level banner.
let fieldError: string | undefined;
let bannerError: string | undefined;
if (result?.error) {
  if (isInputError(result.error)) {
    fieldError = result.error.fields.email?.[0] ?? "Please enter a valid email address.";
  } else {
    bannerError = result.error.message;
  }
} else if (queryError === "invalid") {
  bannerError =
    "That sign-in link is invalid or has expired. Please request a new one.";
} else if (queryError === "required") {
  bannerError = "Please sign in to view the members area.";
} else if (queryError === "unavailable") {
  bannerError = missing.length
    ? `Member sign-in isn't set up yet — the site is missing configuration (${missing.join(", ")}). Please contact website@fallscreekranch.org.`
    : "Member sign-in isn't available yet. Please contact website@fallscreekranch.org.";
}
---

<StarlightPage
  frontmatter={{
    title: "Member Sign In",
    slug: "login",
    description:
      "Sign in to the Falls Creek Ranch members area with an email link.",
    tableOfContents: false,
    pagefind: false,
  }}
>
  <p>
    Enter the email address on file in the resident directory and we will send
    you a sign-in link. No password needed.
  </p>

  {bannerError && <Alert variant="error">{bannerError}</Alert>}

  {
    sent ? (
      <Alert>
        Check your inbox! If that email is in the resident directory, a sign-in
        link is on its way. The link expires in 30 minutes.
      </Alert>
    ) : (
      <form
        method="POST"
        action={actions.auth.requestLink}
        class="form-stack form-card"
        data-enhance
      >
        <Field
          name="email"
          id="email"
          label="Email address"
          type="email"
          error
          errorMessage={fieldError}
          required
          autocomplete="email"
          placeholder="you@example.com"
        />
        <SubmitButton>Email me a sign-in link</SubmitButton>
      </form>
    )
  }

  <p class="form-hint login-help">
    Not receiving a link? Your email may not match the one in the resident
    directory — contact
    <a href="mailto:website@fallscreekranch.org">website@fallscreekranch.org</a>
    to update it.
  </p>
</StarlightPage>

<style>
  /* Controls come from src/styles/forms.css; only page-specific spacing
     lives here. */
  .login-help {
    margin-top: 1.5rem;
  }
</style>

<script>
  // Progressive enhancement only: the form works without this (Astro handles
  // the submission and re-renders). This just adds the double-submit guard.
  import { enhanceForm, restoreOnPageShow } from "~/lib/forms";

  document
    .querySelectorAll<HTMLFormElement>("form[data-enhance]")
    .forEach((form) => enhanceForm(form));
  restoreOnPageShow();
</script>
