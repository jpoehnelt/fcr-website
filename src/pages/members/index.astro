---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import SubmitButton from "~/components/forms/SubmitButton.astro";

export const prerender = false;

// Set by src/middleware.ts — unauthenticated requests are redirected to
// /login before this page renders.
const email = Astro.locals.user?.email;
---

<StarlightPage
  frontmatter={{
    title: "Members Area",
    slug: "members",
    description: "Members-only resources for Falls Creek Ranch residents.",
    tableOfContents: false,
    pagefind: false,
  }}
>
  <p>
    You are signed in as <strong>{email}</strong>.
  </p>

  <ul>
    <li>
      <a href="/members/vehicles">Vehicle license plates</a> — register your
      plates for automatic gate access.
    </li>
  </ul>

  <p>
    More members-only content will appear here. If there is something you
    would like to see in this area, let the board know at
    <a href="mailto:board@fallscreekranch.org">board@fallscreekranch.org</a>.
  </p>

  <form method="post" action="/api/auth/logout" class="logout-form">
    <SubmitButton variant="secondary">Sign out</SubmitButton>
  </form>
</StarlightPage>

<style>
  .logout-form {
    margin-top: 2rem;
  }
</style>
