---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { actions, isInputError } from "astro:actions";
import {
  findUserByEmail,
  getLicensePlates,
  getUnifiEnv,
  MAX_PLATES_PER_USER,
  UnifiApiError,
  type LicensePlate,
} from "~/lib/unifi";
import { PLATE_INPUT_MAXLENGTH, PLATE_RULE_TEXT } from "~/lib/plates";
import Alert from "~/components/forms/Alert.astro";
import Field from "~/components/forms/Field.astro";
import SubmitButton from "~/components/forms/SubmitButton.astro";

export const prerender = false;

// Set by src/middleware.ts — unauthenticated requests never reach here.
const email = Astro.locals.user!.email;

type State =
  | { kind: "not-configured" }
  | { kind: "no-account" }
  | { kind: "misconfigured" }
  | { kind: "error" }
  | { kind: "ok"; plates: LicensePlate[] };

let state: State;
const unifiEnv = getUnifiEnv(Astro.locals);
if (!unifiEnv) {
  state = { kind: "not-configured" };
} else {
  try {
    const user = await findUserByEmail(unifiEnv, email);
    state = user
      ? { kind: "ok", plates: await getLicensePlates(unifiEnv, user.id) }
      : { kind: "no-account" };
  } catch (error) {
    console.error(
      `Failed to load license plates for ${email}:`,
      error instanceof Error ? error.message : error,
    );
    // A rejected token is an admin problem, not a blip — telling the
    // member to try again later would be a dead end.
    state =
      error instanceof UnifiApiError && error.isConfigurationFault
        ? { kind: "misconfigured" }
        : { kind: "error" };
  }
}

// Outcomes of the add/remove Actions. A field-level problem (an invalid
// plate) shows inline on the input; everything else is a page-level banner.
const addResult = Astro.getActionResult(actions.members.addPlate);
const removeResult = Astro.getActionResult(actions.members.removePlate);

// POST-Redirect-GET on success: redirect so a browser reload can't resubmit
// the mutation (and re-trigger the resubmission prompt). The outcome rides
// back on ?status= and is rebuilt on the GET. Errors render in place.
if (addResult && !addResult.error) {
  return Astro.redirect("/members/vehicles?status=added");
}
if (removeResult && !removeResult.error) {
  return Astro.redirect("/members/vehicles?status=removed");
}

const status = Astro.url.searchParams.get("status");
let successMessage: string | undefined;
if (status === "added") {
  successMessage =
    "License plate added. Gate cameras usually pick up changes within a minute.";
} else if (status === "removed") {
  successMessage = "License plate removed.";
}

let bannerError: string | undefined;
let plateFieldError: string | undefined;
if (addResult?.error) {
  if (isInputError(addResult.error)) {
    plateFieldError = addResult.error.fields.plate?.[0] ?? PLATE_RULE_TEXT;
  } else {
    bannerError = addResult.error.message;
  }
}
if (removeResult?.error) {
  bannerError = removeResult.error.message;
}
---

<StarlightPage
  frontmatter={{
    title: "Vehicle License Plates",
    slug: "members/vehicles",
    description:
      "Register your vehicle license plates for gate access at Falls Creek Ranch.",
    tableOfContents: false,
    pagefind: false,
  }}
>
  <p>
    Plates registered here unlock the gate automatically via camera license
    plate recognition. They are linked to your UniFi Access account
    (<strong>{email}</strong>).
  </p>

  {successMessage && <Alert>{successMessage}</Alert>}
  {bannerError && <Alert variant="error">{bannerError}</Alert>}

  {
    state.kind === "not-configured" && (
      <p>
        Vehicle registration isn't available yet — the gate system connection
        hasn't been configured. Please check back later or contact
        <a href="mailto:board@fallscreekranch.org"> board@fallscreekranch.org</a>.
      </p>
    )
  }

  {
    state.kind === "no-account" && (
      <p>
        We couldn't find a gate-access account for <strong>{email}</strong>.
        Contact
        <a href="mailto:board@fallscreekranch.org"> board@fallscreekranch.org</a>
        to get set up.
      </p>
    )
  }

  {
    state.kind === "misconfigured" && (
      <p>
        The gate system is refusing our connection, which needs an
        administrator to fix. Please contact
        <a href="mailto:board@fallscreekranch.org"> board@fallscreekranch.org</a>
        — trying again later won't help until it's sorted out.
      </p>
    )
  }

  {
    state.kind === "error" && (
      <p>
        We couldn't reach the gate system just now. Please try again later, or
        contact
        <a href="mailto:board@fallscreekranch.org"> board@fallscreekranch.org</a>
        if this keeps happening.
      </p>
    )
  }

  {
    state.kind === "ok" && (
      <>
        <h2>Your registered plates</h2>
        {state.plates.length === 0 ? (
          <p>No plates registered yet.</p>
        ) : (
          <ul class="plate-list">
            {state.plates.map((plate) => (
              <li>
                <code>{plate.plate}</code>
                {plate.status !== "active" && (
                  <span class="plate-status">inactive</span>
                )}
                <form
                  method="POST"
                  action={actions.members.removePlate}
                  class="plate-remove"
                  data-enhance
                >
                  <input type="hidden" name="plateId" value={plate.id} />
                  <SubmitButton
                    variant="secondary"
                    aria-label={`Remove plate ${plate.plate}`}
                  >
                    Remove
                  </SubmitButton>
                </form>
              </li>
            ))}
          </ul>
        )}

        {state.plates.length < MAX_PLATES_PER_USER && (
          <form
            method="POST"
            action={actions.members.addPlate}
            class="form-stack plate-add form-card"
            data-enhance
          >
            <Field
              name="plate"
              id="plate"
              label="Add a plate"
              row
              error
              errorMessage={plateFieldError}
              inputClass="form-input--plate"
              hint={`${PLATE_RULE_TEXT} No state. Up to ${MAX_PLATES_PER_USER} plates.`}
              required
              maxlength={PLATE_INPUT_MAXLENGTH}
              autocomplete="off"
              autocapitalize="characters"
              spellcheck="false"
              placeholder="ABC123"
            >
              <SubmitButton>Add plate</SubmitButton>
            </Field>
          </form>
        )}
      </>
    )
  }

  <p class="plate-back">
    <a href="/members">&larr; Back to members area</a>
  </p>
</StarlightPage>

<style>
  /* Controls come from src/styles/forms.css; only the plate list layout
     is specific to this page. */
  .plate-list {
    list-style: none;
    padding: 0;
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .plate-list li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.6rem;
    background: color-mix(in srgb, var(--sl-color-gray-6) 55%, var(--sl-color-bg));
  }
  .plate-list code {
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-lg);
    text-transform: uppercase;
    letter-spacing: 0.16em;
  }
  /* Pushes the Remove form to the right edge of the row. */
  .plate-remove {
    margin-left: auto;
  }
  .plate-status {
    padding: 0.15rem 0.55rem;
    border-radius: 1rem;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .plate-add {
    margin-top: 1.5rem;
  }
  .plate-back {
    margin-top: 2rem;
  }
</style>

<script>
  // Progressive enhancement over the Action: instant plate validation, a
  // confirm before removing, and a double-submit guard. Without JS the form
  // still submits and the server reports the same problems.
  import { describePlateProblem } from "~/lib/plates";
  import { enhanceForm, restoreOnPageShow } from "~/lib/forms";

  // data-enhance is the opt-in marker (see ~/lib/forms). The add form is the
  // enhanced form that isn't a remove form; the rest are the remove forms.
  const plateForm = document.querySelector<HTMLFormElement>(
    "form[data-enhance]:not(.plate-remove)",
  );
  const plateInput = document.getElementById("plate") as HTMLInputElement | null;
  const plateError = document.getElementById("plate-error");
  if (plateForm && plateInput && plateError) {
    enhanceForm(plateForm, {
      field: {
        input: plateInput,
        error: plateError,
        validate: describePlateProblem,
      },
    });
  }

  document
    .querySelectorAll<HTMLFormElement>("form[data-enhance].plate-remove")
    .forEach((form) => {
      const label = form.querySelector("button")?.getAttribute("aria-label");
      const plate = label?.replace(/^Remove plate /, "") ?? "this plate";
      enhanceForm(form, {
        confirm: () => `Remove ${plate}? It will lose gate access.`,
      });
    });

  restoreOnPageShow();
</script>
