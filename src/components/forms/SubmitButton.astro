---
/**
 * A submit button in the members form palette. `secondary` is the quieter
 * outline style used for destructive or lower-emphasis actions.
 */
interface Props {
  variant?: "primary" | "secondary";
  class?: string;
  [attr: string]: unknown;
}

const { variant = "primary", class: className, ...rest } = Astro.props;
---

<button
  type="submit"
  class:list={[
    "form-button",
    { "form-button--secondary": variant === "secondary" },
    className,
  ]}
  {...rest}
>
  <slot />
</button>
