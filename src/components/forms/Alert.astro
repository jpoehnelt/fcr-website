---
/**
 * A status banner in the members form palette. `error` uses the red
 * treatment and `role="alert"`; the success default uses `role="status"`.
 */
interface Props {
  variant?: "success" | "error";
  id?: string;
  hidden?: boolean;
}

const { variant = "success", id, hidden = false } = Astro.props;
---

<div
  id={id}
  class:list={["form-alert", { "form-alert--error": variant === "error" }]}
  role={variant === "error" ? "alert" : "status"}
  hidden={hidden}
>
  <slot />
</div>
