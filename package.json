    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "googleapis": "^164.1.0",
    "playwright": "^1.56.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "totp-generator": "^2.0.0",
    "zod": "3.25.76"
