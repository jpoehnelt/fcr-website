    "@sveltejs/adapter-cloudflare": "^7.2.4",
    "@sveltejs/kit": "^2.46.5",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "mdsvex": "^0.12.6",
    "mode-watcher": "^1.1.0",
    "storybook": "^10.5.7",
    "svelte": "^5.42.2",
    "svelte-check": "^4.3.3",
    "svelte-sonner": "^1.1.1",
    "tailwindcss": "^4.3.3",
