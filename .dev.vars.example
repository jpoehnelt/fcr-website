# Copy to .dev.vars for local development (`pnpm preview` / `pnpm dev`).
#
# In production, set these as Cloudflare Workers secrets:
# `wrangler secret put <NAME>`.
#
# Wrangler reads `wrangler.jsonc`, including the `nodejs_compat` compatibility
# flag used by the SvelteKit Worker.

# Random string used to sign magic-link tokens and session cookies.
# Must be at least 32 characters — a weak secret makes sessions and magic
# links forgeable, so a short one is rejected at startup rather than used.
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Service account with read access to the resident directory and announcement
# sheets (same account used by automation/directory.js).
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""

# Spreadsheet ID of the resident directory.
GOOGLE_SHEET_ID=""

# Optional: where the addresses live. Defaults to "emails!A:A" — column A
# of the `emails` tab. Only set this if the directory moves.
# GOOGLE_SHEET_RANGE="emails!A:A"

# Optional: Google Calendar ID for tennis and pickleball court reservations.
# Defaults to "c_8ebd77704e859a7473f0e62259820f9720106233a4a0a75e9e376ac5c94ef5c9@group.calendar.google.com".
# Only set this if you want to point to a different or personal test calendar.
# Make sure the calendar is shared with GOOGLE_SERVICE_ACCOUNT_EMAIL ("Make changes to events").
# GOOGLE_TENNIS_CALENDAR_ID="c_8ebd77704e859a7473f0e62259820f9720106233a4a0a75e9e376ac5c94ef5c9@group.calendar.google.com"

# Resend (https://resend.com) API key for sending magic-link emails.
# The fallscreekranch.org domain must be verified in Resend.
RESEND_API_KEY=""
EMAIL_FROM="Falls Creek Ranch <no-reply@fallscreekranch.org>"

# Optional rollout guard for automatic gate PIN emails. Comma-separated,
# case-insensitive addresses. Leave unset or blank to process every eligible
# resident without a PIN.
# GATE_PIN_EMAIL_ALLOWLIST="test-resident@example.com"

# UniFi Access (member gate dashboard). Only the token is required — until
# it is set, /members shows a "not available yet" notice. Token: Access >
# Settings > General > Advanced > API Token, with view:user, edit:user,
# view:visitor, edit:visitor, and view:credential permissions. License plate
# endpoints need UniFi Access 3.3.10 or later.
UNIFI_ACCESS_API_TOKEN=""

# Optional: defaults to https://gate.fallscreekranch.org. Set only if the
# tunnel hostname changes. Must be publicly reachable HTTPS with a valid
# certificate, fronting the console's Open API port 12445 — Workers cannot
# skip TLS verification for the console's own self-signed cert.
# UNIFI_ACCESS_API_URL="https://gate.fallscreekranch.org"
