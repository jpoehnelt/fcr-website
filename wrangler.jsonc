{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fcr-website",
  "compatibility_date": "2026-07-20",
  "observability": {
    "enabled": true
  },
  "main": "worker.ts",
  "compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "r2_buckets": [
    { "binding": "SPILLWAY_SNAPSHOTS", "bucket_name": "fcr-spillway-snapshots" }
  ],
  "triggers": {
    // Reconcile the Google Sheet into UniFi Access every 10 minutes, in UTC.
    // Separate hourly job captures the spillway at 08:00–20:00 America/Denver.
    "crons": ["*/10 * * * *", "0 * * * *"]
  }
}
